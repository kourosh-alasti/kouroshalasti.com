{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-06-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
  },
  "workers_dev": false,
  "routes": [
    {
      "enabled": true,
      "custom_domain": true,
      "pattern": "kouroshalasti.com",
    },
  ],
}
